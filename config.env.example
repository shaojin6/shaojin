# Kubernetes API 配置
# API 服务器地址（Kubernetes API 通常使用 HTTPS，端口 6443）
# 如果配置为 HTTP，代码会自动转换为 HTTPS
K8S_API_SERVER=https://11.0.1.110:6443

# 认证方式 1: 使用 Token（推荐）
# 使用 k8s-mcp-server-sa ServiceAccount 的 Token（dify 命名空间，管理员权限）
# 获取 Token 的方法：
#   1. 使用脚本: .\scripts\get-token.ps1 (Windows PowerShell)
#   2. 手动获取:
#      kubectl get secret -n dify $(kubectl get sa k8s-mcp-server-sa -n dify -o jsonpath='{.secrets[0].name}') -o jsonpath='{.data.token}' | base64 -d
K8S_API_TOKEN=your-token-here

# 认证方式 2: 使用用户名和密码（如果使用 Token，可以注释掉这两行）
# K8S_API_USERNAME=your-username
# K8S_API_PASSWORD=your-password

# TLS 配置
# 如果 API 服务器使用自签名证书，设置为 true 跳过验证（仅用于开发环境）
K8S_API_INSECURE=true

# CA 证书文件路径（可选）
# K8S_API_CA_FILE=/path/to/ca.crt

# CA 证书内容（Base64 编码，可选）
# K8S_API_CA_DATA=LS0tLS1CRUdJTi...

# Web 服务配置
# Web 服务监听地址（默认 :8080）
# MCP_WEB_ADDR=:8080

# Gin 模式（debug/release/test，默认 release）
# GIN_MODE=release

# Redis 缓存配置（可选，用于工具列表缓存）
# 如果未配置 Redis，将使用数据库缓存（JSON 文件）
REDIS_ADDR=11.0.1.110:31202
REDIS_PASSWORD=difyai123456
REDIS_DB=0

# MySQL 缓存配置（可选，用于工具列表持久化）
# 可以直接提供 MYSQL_DSN；如果未设置，则使用以下字段拼接
MYSQL_HOST=11.0.1.110
MYSQL_PORT=30306
MYSQL_USER=root
MYSQL_PASSWORD=canxixi
MYSQL_DB=mcp
# MYSQL_DSN=root:canxixi@tcp(11.0.1.110:30306)/mcp?parseTime=true&charset=utf8mb4&loc=Local

# MongoDB 会话存储配置（可选，用于会话历史持久化）
# 可以直接提供 MONGODB_URI；如果未设置，则使用以下字段拼接
MONGODB_HOST=11.0.1.110
MONGODB_PORT=30792
MONGODB_DB=mcp
# MONGODB_URI=mongodb://11.0.1.110:30792

